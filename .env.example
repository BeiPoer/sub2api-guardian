# Host port and bind address used by docker-compose.yml.
GUARDIAN_PORT=8787
GUARDIAN_BIND=127.0.0.1
# UID/GID of the host user owning ./backend/data (run `id -u` and `id -g`).
GUARDIAN_UID=1000
GUARDIAN_GID=1000

# Optional: leave empty and configure the connection in the web UI.
# If sub2api runs on the Docker host, use http://host.docker.internal:8080.
SUB2API_BASE_URL=
SUB2API_ADMIN_KEY=

# Optional: overrides the built-in image URL encryption key.
# Changing it invalidates previously generated /images/from/ URLs.
IMAGE2_URL_ENCRYPTION_KEY=
